        }

        /* HOME */
        #home {
            min-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
            color: white;
        }

        .home-content h1 {
            font-size: 48px;
            margin-bottom: 10px;
        }

        .home-content h1 span {
            color: #38bdf8;
        }

        .home-content h2 {
            font-size: 24px;
            margin-bottom: 15px;
        }

        .home-content p {
            max-width: 650px;
            margin: auto;
            color: #dbeafe;
        }

        .btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            background: #38bdf8;
            color: #0f172a;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
        }

        .btn:hover {
            background: white;
        }

        /* GENERAL */
        .section-title {
            text-align: center;
            font-size: 32px;
            margin-bottom: 40px;
            color: #0f172a;
        }

        .section-title span {
            color: #2563eb;
        }

        .about-box {
            max-width: 900px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        /* SKILLS */
        .skills-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
        }

        .skill {
            background: white;
            padding: 25px;
            text-align: center;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.07);
            transition: 0.3s;
        }

        .skill:hover {
            transform: translateY(-5px);
        }

        .skill h3 {
            color: #2563eb;
            margin-bottom: 8px;
        }

        /* PROJECTS */
        .projects-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .project-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .project-card h3 {
            color: #2563eb;
            margin-bottom: 10px;
        }

        .project-card p {
            margin-bottom: 8px;
        }

        /* ACHIEVEMENTS */
        .achievement-list {
            max-width: 850px;
            margin: auto;
        }

        .achievement {
            background: white;
            margin-bottom: 15px;
            padding: 20px;
            border-left: 5px solid #2563eb;
            border-radius: 8px;
        }

        /* CERTIFICATIONS */
        .cert-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .cert {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.07);
        }

        .cert h3 {
            color: #2563eb;
        }

        /* CONTACT */
        .contact-box {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .contact-box p {
            margin: 12px 0;
        }

        .contact-box a {
            color: #2563eb;
            text-decoration: none;
        }

        footer {
            background: #0f172a;
            color: white;
            text-align: center;
            padding: 20px;
        }

